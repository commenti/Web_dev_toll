{
  "manifest_version": 2,
  "name": "NetForge Inspector Traffic Capture",
  "short_name": "NetForge Capture",
  "version": "1.0.0",
  "description": "Built-in GeckoView WebExtension that captures full-fidelity HTTP traffic and forwards it to the NetForge native bridge.",
  "applications": {
    "gecko": {
      "id": "inspector_ext@netforge.inspector",
      "strict_min_version": "113.0"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "webRequest",
    "webRequestBlocking",
    "cookies",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
